# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, signed media stream URLs, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_APP_URL: Optional explicit public base URL override (e.g., https://your-service.run.app)
# used for webhook streamUrl and coverImageUrl links if APP_URL is unset or private.
PUBLIC_APP_URL=
